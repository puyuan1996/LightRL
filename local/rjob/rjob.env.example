# Copy to local/rjob/rjob.env (kept untracked) or export these values in the
# scheduler environment.  Site-specific queue, image and mount details stay
# outside the repository.
RJOB_NAMESPACE="<scheduler-namespace>"
RJOB_GROUP="<charged-group>"
RJOB_IMAGE="<container-image>"
RJOB_MOUNTS="<source-a>:<container-a> <source-b>:<container-b>"
RJOB_PRIVATE_MACHINE="group"
RJOB_PRIORITY="9"
PERSIST_ROOT="<persistent-run-root>"
MATH_DATA_ROOT="<mounted-math-data-root>"

# Optional: use an isolated source checkout when the shared branch is active.
# LIGHTRL_ROOT="/path/to/LightRL"
